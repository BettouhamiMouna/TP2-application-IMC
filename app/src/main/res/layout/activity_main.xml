<?xml version="1.0" encoding="utf-8"?>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    android:gravity="center_horizontal">

    <TextView
        android:id="@+id/textViewTitre"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/titre_imc"
        android:textSize="28sp"
        android:textStyle="bold"
        android:layout_marginBottom="30dp" />

    <EditText
        android:id="@+id/editTextTaille"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/hint_taille"
        android:inputType="numberDecimal"
        android:layout_marginBottom="24dp" />

    <Button
        android:id="@+id/buttonCalculer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/calculer"
        android:layout_marginBottom="10dp" />

    <Button
        android:id="@+id/buttonEffacer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/effacer"
        android:layout_marginBottom="30dp" />

    <TextView
        android:id="@+id/textViewImc"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/resultat_imc"
        android:textSize="22sp"
        android:textStyle="bold"
        android:layout_marginBottom="15dp" />

    <TextView
        android:id="@+id/textViewCategorie"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/categorie"
        android:textSize="20sp"
        android:textStyle="bold" />

</LinearLayout>